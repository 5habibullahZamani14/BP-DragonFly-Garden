PORT=5000
HOST=0.0.0.0

# Optional direct HTTPS. Set both paths to enable HTTPS for the API and WebSocket.
# The paths are resolved relative to the backend process working directory.
# For LAN/production use, install a certificate trusted by client devices.
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Optional reverse-proxy support: set to the number of trusted proxy hops only
# when the backend cannot be reached directly by untrusted clients.
TRUST_PROXY_HOPS=0

# Resend API Key — get a free key at https://resend.com
# Used to send password-reset emails to the manager.
RESEND_API_KEY=

# The "from" email address shown in reset emails.
# With a free Resend account, use: onboarding@resend.dev
# With a custom domain, use e.g.: system@dragonflygarden.com
EMAIL_FROM=onboarding@resend.dev

# Groq API Key — get a free key at https://console.groq.com/keys
# Used for AI-powered feedback analysis in the manager dashboard.
# This is optional - if not set, the system will fall back to rule-based analysis.
GROQ_API_KEY=

# REQUIRED: generate a unique random value of at least 32 bytes before starting.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated full GPG fingerprints allowed to sign in-app updates.
# Leave blank to disable the in-app updater until a trusted key is configured.
UPDATE_TRUSTED_COMMIT_SIGNERS=

# CORS origins (comma-separated). In production set to your frontend origin(s).
# When HTTPS is enabled, use https:// origins (for example https://10.42.0.1:5000).
# Add the Vite dev server origin used during local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.example,http://10.42.0.1:5000

# The target URL used by captive portal checks such as /hotspot-detect.html and /generate_204.
# This can also be configured at runtime in the manager settings UI.
# Optional: set to the server's reachable LAN/hotspot URL if it cannot be detected.
# CAPTIVE_PORTAL_TARGET=http://10.42.0.1:5000/

# If set to 1, server runs in Vite dev passthrough mode (less restrictive CORS)
VITE_DEV_MODE=0

# SQLite data is stored in src/database/database.sqlite.

# Required for automated backups: a base64-encoded 32-byte AES-256 key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key and .env files outside the backup archive in a separate secret store.
BACKUP_ENC_KEY=

# Optional cloud-backup retention. Unset means no remote backups are deleted.
# Set to an approved number of days (1-3650) to delete older remote full backups;
# the newest backup is always retained. Local backups use a 7-day rolling window.
# Configure equivalent lifecycle expiry for prior object versions in versioned buckets.
B2_BACKUP_RETENTION_DAYS=

# Notes:
# - Never commit a real secret to version control. Keep .env in .gitignore.
# - To generate a secure secret: `openssl rand -base64 32` (or use a secrets manager).
